# Copy to .env and adjust locally. Never commit .env or real credentials.
GRADIO_PORT=7860
WEB_METRICS_PORT=8001
API_HOST=0.0.0.0
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Blank uses the local-development fallback in compose.yaml.
GRAFANA_PASSWORD=

# Leave unset: Compose uses host.docker.internal; local Python uses localhost.
# Set explicitly only when using a different Ollama server.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
VISION_BACKEND=ollama
OLLAMA_CONTEXT=4096
OLLAMA_TIMEOUT=120

WHISPER_MODEL=openai/whisper-small
NLP_MODEL=cointegrated/rubert-tiny2-cedr-emotion-detection
IMAGE_MODEL=Salesforce/blip-image-captioning-large
VLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
YOLO_MODEL=yolo26s.pt
DEFAULT_TWITCH_CHANNEL=
