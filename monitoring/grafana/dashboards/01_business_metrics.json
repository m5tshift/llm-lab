{
  "uid": "twitch-business",
  "title": "1. Прямой эфир",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "twitch",
    "operational"
  ],
  "panels": [
    {
      "title": "Эфир активен (1/0)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "twitch_stream_active{job=\"twitch_bot_web\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Длительность текущей сессии",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "twitch_session_duration_seconds{job=\"twitch_bot_web\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Обработанные кадры/с",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Реальная пропускная способность, включая ожидание UI/сети. Не FPS источника Twitch.",
      "fieldConfig": {
        "defaults": {
          "unit": "fps",
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(twitch_frames_processed_total{job=\"twitch_bot_web\"}[1m])",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Полученные сообщения/мин",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Считаются на входе IRC; повторный анализ окна не увеличивает счётчик.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(twitch_chat_received_messages_total{job=\"twitch_bot_web\"}[1m]) * 60",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
