# Track only application sources, runtime configuration and development tools.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/README.md
!/Dockerfile
!/compose.yaml
!/Makefile
!/pyproject.toml
!/uv.lock
!/.pre-commit-config.yaml
!/.github/
!/src/
!/tests/
!/monitoring/
!/samples/
!/evals/
!/scripts/

# Keep only scripts that support the system.
/scripts/*
!/scripts/build_3_dashboards.py
!/scripts/run_evals.py
!/scripts/verify_unified_model.py

# Only the bundled demonstration fixtures belong in the repository.
/samples/*
!/samples/chat_messages.json
!/samples/sample_speech.wav
!/samples/sample_stream.jpg
/evals/*
!/evals/cases.json

# Local configuration, credentials and editor settings at any depth.
.env
.env.*
!/.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
.ssh/
.agents/
.codex/
.vscode/
.idea/
credentials.json
secrets.json
secrets.yaml
secrets.yml

# Local caches, runtime data and generated files inside tracked directories.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.log
*.err
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*.db
*.sqlite
*.sqlite3
/monitoring/grafana/data/
*.pt
*.wav
!/samples/sample_speech.wav
*.mp3
*.mp4
*.mkv
*.webm

# Reports, coursework, exported documents and archives stay local at any depth.
[Rr][Ee][Pp][Oo][Rr][Tt]*
[Оо][Тт][Чч][ЕеЁё][Тт]*
*.typ
*.pdf
*.doc
*.docx
*.odt
*.ppt
*.pptx
*.xls
*.xlsx
*.zip
*.7z
*.tar
*.gz

# Documentation other than the root README stays local.
*.md
!/README.md
